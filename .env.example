# Copy to a local `.env` only on your machine — never commit real values.
# Vercel: set these in Project → Settings → Environment Variables.

# Postgres connection string (Vercel Postgres / Neon / any Postgres).
# When unset, local/dev API uses in-memory PGlite.
DATABASE_URL=

# Optional direct (unpooled) URL for migrations on pooler setups.
DATABASE_URL_UNPOOLED=

# Cookie signing secret — required for auth in production (16+ characters).
SESSION_SECRET=

# Optional: Resend API key for password-reset emails.
# Without it, local/dev forgot-password returns a resetPath for testing.
RESEND_API_KEY=
RESET_EMAIL_FROM=Zenna <onboarding@resend.dev>
# Force including resetPath in forgot-password responses (never on production).
ALLOW_DEV_RESET_LINKS=

# Google Analytics 4 Measurement ID (public, safe for the browser).
# Create a GA4 property at https://analytics.google.com → Admin → Data streams
# → Web → copy Measurement ID (G-XXXXXXXXXX). Leave blank to disable analytics.
VITE_GA_MEASUREMENT_ID=
