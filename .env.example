# Copy to a local `.env` only on your machine — never commit real values.
# Vercel: set these in Project → Settings → Environment Variables.

# Postgres connection string (Vercel Postgres / Neon / any Postgres).
# When unset, local/dev API uses in-memory PGlite.
DATABASE_URL=

# Optional direct (unpooled) URL for migrations on pooler setups.
DATABASE_URL_UNPOOLED=

# Cookie signing secret — required for auth in production (16+ characters).
SESSION_SECRET=
